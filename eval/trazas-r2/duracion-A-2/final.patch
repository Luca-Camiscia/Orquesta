+import re
+
+
 def parse_duration(text: str) -> int:
-    """Convierte duraciones como "1h30m" o "45s" a segundos."""
-    total = 0
-    for unidad, factor in (("h", 3600), ("m", 60), ("s", 1)):
-        if unidad in text:
-            numero, text = text.split(unidad)
-            total += int(numero) * factor
-    return total
+    """Convierte enteros no negativos con unidades h, m, s en ese orden.
+
+    Las unidades son opcionales, pero debe aparecer al menos una.
+    Lanza ValueError si la duración no respeta el formato.
+    """
+    match = (
+        re.fullmatch(r"(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", text)
+        if isinstance(text, str)
+        else None
+    )
+    if match is None or not any(match.groups()):
+        raise ValueError("duración inválida: usá enteros con unidades h, m, s en ese orden")
+    return sum(
+        int(number) * factor
+        for number, factor in zip(match.groups(), (3600, 60, 1))
+        if number is not None
+    )
diff --git a/test_duration.py b/test_duration.py
