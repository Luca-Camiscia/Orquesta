@@ -1,5 +1,23 @@
+import pytest
+
 from codigo import slugify
 
 
 def test_basico():
     assert slugify("Hola Mundo") == "hola-mundo"
+
+
+@pytest.mark.parametrize(
+    ("titulo", "esperado"),
+    [
+        ("ÁÉÍÓÚ áéíóú Ññ Üü", "aeiou-aeiou-nn-uu"),
+        ("¡Canción del año! ¿Qué tal?", "cancion-del-ano-que-tal"),
+        ("  Pingüino\t y  acción -- 2026\n", "pinguino-y-accion-2026"),
+        ("Cafe\u0301 y nin\u0303o", "cafe-y-nino"),
+        ("acción/reacción & salud", "accion-reaccion-salud"),
+        ("", ""),
+        (" ¡¿ --- \t", ""),
+    ],
+)
+def test_slug_para_urls(titulo, esperado):
+    assert slugify(titulo) == esperado
