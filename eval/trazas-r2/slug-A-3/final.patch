@@ -1,5 +1,26 @@
+import pytest
+
 from codigo import slugify
 
 
 def test_basico():
     assert slugify("Hola Mundo") == "hola-mundo"
+
+
+@pytest.mark.parametrize(
+    ("titulo", "esperado"),
+    [
+        ("Canción del año", "cancion-del-ano"),
+        ("ÁÉÍÓÚ Ñ Ü", "aeiou-n-u"),
+        ("Cancio\u0301n del an\u0303o", "cancion-del-ano"),
+        ("  ¡Hola, España!  ", "hola-espana"),
+        ("Pingüino\tazul / 2026", "pinguino-azul-2026"),
+        ("uno\n dos   tres", "uno-dos-tres"),
+        ("---niñez__y--educación---", "ninez-y-educacion"),
+        ("¿Qué? #100% & más", "que-100-mas"),
+        ("", ""),
+        (" ¡¿?! / ", ""),
+    ],
+)
+def test_slug_para_url(titulo, esperado):
+    assert slugify(titulo) == esperado
