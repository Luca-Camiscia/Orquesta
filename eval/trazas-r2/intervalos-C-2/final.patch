+import pytest
+
 from codigo import merge_intervals
 
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+def test_intervalos_cerrados_con_extremo_compartido():
+    assert merge_intervals([[1, 3], [3, 3], [3, 5]]) == [[1, 5]]
+
+
+def test_intervalos_desordenados_con_solapamientos_en_cadena():
+    intervals = [[12, 14], [5, 7], [2, 3], [1, 6], [7, 10]]
+    assert merge_intervals(intervals) == [[1, 10], [12, 14]]
+
+
+@pytest.mark.parametrize(
+    "intervals, expected",
+    [
+        ([], []),
+        ([[2, 2]], [[2, 2]]),
+        ([[1, 10], [2, 3], [4, 5]], [[1, 10]]),
+        ([[1, 3], [1, 3], [1, 2]], [[1, 3]]),
+        ([[3, 3], [1, 3], [3, 5]], [[1, 5]]),
+        ([[5, 6], [1, 2], [3, 4]], [[1, 2], [3, 4], [5, 6]]),
+        ([[-2.5, -1], [-1, 0.5], [0.75, 2]], [[-2.5, 0.5], [0.75, 2]]),
+        ([(3, 5), (1, 3)], [[1, 5]]),
+    ],
+)
+def test_casos_borde(intervals, expected):
+    assert merge_intervals(intervals) == expected
+
+
+def test_acepta_iterador():
+    assert merge_intervals(iter([(3, 5), (1, 3)])) == [[1, 5]]
+
+
+def test_no_modifica_entrada_ni_comparte_intervalos():
+    intervals = [[3, 5], [1, 3], [8, 9]]
+    result = merge_intervals(intervals)
+    assert result == [[1, 5], [8, 9]]
+    assert intervals == [[3, 5], [1, 3], [8, 9]]
+    result[0][1] = 100
+    result[1][1] = 200
+    assert intervals == [[3, 5], [1, 3], [8, 9]]
+
+
+@pytest.mark.parametrize(
+    "intervals",
+    [
+        [[5, 1]],
+        [[1, 10], [7, 2]],
+        [[5, 1], [1, 10]],
+        [[float("nan"), 2]],
+        [[1, float("nan")], [2, 3]],
+        [[]],
+        [[1]],
+        [[1, 2, 3]],
+    ],
+)
+def test_rechaza_intervalos_invalidos(intervals):
+    with pytest.raises(ValueError):
+        merge_intervals(intervals)
+
+
+@pytest.mark.parametrize("intervals", [None, [None], [[None, 2]], [[1, "2"]]])
+def test_rechaza_entradas_de_tipo_incompatible(intervals):
+    with pytest.raises(TypeError):
+        merge_intervals(intervals)
