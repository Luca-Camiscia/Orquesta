 def merge_intervals(intervals):
-    """Une intervalos cerrados [a, b] que se solapan."""
-    result = []
+    """Une intervalos cerrados [a, b] que se solapan, sin modificar la entrada.
+
+    Cada intervalo debe tener dos extremos comparables con a <= b.
+    Pares mal formados, invertidos o con NaN provocan ValueError;
+    tipos incompatibles provocan TypeError.
+    """
+    intervals = list(intervals)
     for a, b in intervals:
-        if result and a < result[-1][1]:
+        if not a <= b:
+            raise ValueError("Cada intervalo debe cumplir a <= b")
+    result = []
+    for a, b in sorted(intervals, key=lambda interval: interval[0]):
+        if result and a <= result[-1][1]:
             result[-1][1] = max(result[-1][1], b)
         else:
             result.append([a, b])
