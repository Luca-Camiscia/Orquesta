+import pytest
+
 from codigo import slugify
 
 
 def test_basico():
     assert slugify("Hola Mundo") == "hola-mundo"
+
+
+@pytest.mark.parametrize(
+    "titulo, esperado",
+    [
+        ("Canción del año", "cancion-del-ano"),
+        ("ÁÉÍÓÚ Ñ Ü", "aeiou-n-u"),
+        ("¡Qué pingüino! ¿Cómo está?", "que-pinguino-como-esta"),
+        ("  Hola\t mundo\n  ", "hola-mundo"),
+        ("Guía__de---viaje / 2026", "guia-de-viaje-2026"),
+        ("Cancio\u0301n del an\u0303o", "cancion-del-ano"),
+        ("Madrid–Barcelona", "madrid-barcelona"),
+        ("2020–2026", "2020-2026"),
+        ("Capítulo 1—Introducción", "capitulo-1-introduccion"),
+        ("pregunta¿verdad?", "pregunta-verdad"),
+        ("hola«mundo»", "hola-mundo"),
+        ("Receta ½ taza", "receta-taza"),
+        ("Área 2²", "area-2"),
+        ("", ""),
+        (" ¡! --- ", ""),
+    ],
+)
+def test_slug_para_urls(titulo, esperado):
+    assert slugify(titulo) == esperado
