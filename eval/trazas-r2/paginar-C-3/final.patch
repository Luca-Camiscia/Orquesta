diff --git a/codigo.py b/codigo.py
index 0aab7fb..68d94b9 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,4 +1,13 @@
 def paginate(items, page, per_page):
-    """Devuelve la página `page` (empezando en 1) de `items`."""
-    start = page * per_page
+    """Devuelve la página `page` (empezando en 1) de `items`.
+
+    `page` y `per_page` deben ser enteros positivos, excluyendo booleanos.
+    Tipos inválidos generan TypeError; valores no positivos, ValueError.
+    """
+    for name, value in (("page", page), ("per_page", per_page)):
+        if not isinstance(value, int) or isinstance(value, bool):
+            raise TypeError(f"{name} debe ser un entero")
+        if value < 1:
+            raise ValueError(f"{name} debe ser mayor que cero")
+    start = (page - 1) * per_page
     return items[start:start + per_page]
diff --git a/test_visible.py b/test_visible.py
index 635458a..6ed1c14 100644
--- a/test_visible.py
+++ b/test_visible.py
@@ -1,5 +1,48 @@
+import pytest
+
 from codigo import paginate
 
 
 def test_primera_pagina():
     assert paginate(list(range(10)), 1, 3) == [0, 1, 2]
+
+
+@pytest.mark.parametrize(
+    "page, per_page, expected",
+    [
+        (2, 3, [3, 4, 5]),
+        (3, 3, [6, 7, 8]),
+        (4, 3, [9]),
+        (5, 3, []),
+        (100, 3, []),
+        (2, 5, [5, 6, 7, 8, 9]),
+        (3, 5, []),
+        (10, 1, [9]),
+        (1, 20, list(range(10))),
+    ],
+)
+def test_paginas_y_limites(page, per_page, expected):
+    items = list(range(10))
+    assert paginate(items, page, per_page) == expected
+    assert items == list(range(10))
+
+
+@pytest.mark.parametrize("page", [1, 2])
+def test_lista_vacia(page):
+    assert paginate([], page, 3) == []
+
+
+@pytest.mark.parametrize("parameter", ["page", "per_page"])
+@pytest.mark.parametrize("value", [0, -1, -3])
+def test_rechaza_valores_no_positivos(parameter, value):
+    kwargs = {"page": 1, "per_page": 3, parameter: value}
+    with pytest.raises(ValueError):
+        paginate(list(range(10)), **kwargs)
+
+
+@pytest.mark.parametrize("parameter", ["page", "per_page"])
+@pytest.mark.parametrize("value", [1.0, 1.5, "1", None, True, False])
+def test_rechaza_tipos_invalidos(parameter, value):
+    kwargs = {"page": 1, "per_page": 3, parameter: value}
+    with pytest.raises(TypeError):
+        paginate(list(range(10)), **kwargs)
