@@ -0,0 +1,86 @@
+import pytest
+
+from codigo import parse_duration
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("1h", 3600),
+        ("30m", 1800),
+        ("45s", 45),
+        ("1h30m", 5400),
+        ("1h45s", 3645),
+        ("30m45s", 1845),
+        ("1h30m45s", 5445),
+        ("0h0m0s", 0),
+        ("0s", 0),
+        ("0h", 0),
+        ("0m", 0),
+        ("0h0m", 0),
+        ("0h0s", 0),
+        ("0m0s", 0),
+        ("001h02m03s", 3723),
+        ("90m", 5400),
+        ("120s", 120),
+        ("12345678901234567890s", 12345678901234567890),
+    ],
+)
+def test_convierte_componentes_en_orden(text, expected):
+    assert parse_duration(text) == expected
+
+
+@pytest.mark.parametrize("unit, factor", [("h", 3600), ("m", 60), ("s", 1)])
+@pytest.mark.parametrize(
+    "digits, expected",
+    [("0" * 5000 + "1", 1), ("1" + "0" * 5000, 10**5000)],
+    ids=["ceros-iniciales", "entero-grande"],
+)
+def test_acepta_componentes_largos(unit, factor, digits, expected):
+    assert parse_duration(digits + unit) == expected * factor
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "basura",
+        "123",
+        "h",
+        "m",
+        "s",
+        "1hbasura",
+        "45sbasura",
+        "basura45s",
+        "1m2h",
+        "1s2m",
+        "1s2h",
+        "1h2s3m",
+        "1h2h",
+        "1m2m",
+        "1s2s",
+        "-1h",
+        "+1m",
+        "1.5h",
+        "1H",
+        " 1h",
+        "1h ",
+        "1h 2m",
+        "1h\t2m",
+        "1h\n2m",
+        "1m\x002s",
+        "45s\n",
+        "１h",
+        "١s",
+        None,
+        45,
+        True,
+        1.5,
+        b"45s",
+        [],
+        {},
+    ],
+)
+def test_rechaza_entradas_invalidas_con_error_claro(text):
+    with pytest.raises(ValueError, match="Duración inválida"):
+        parse_duration(text)
