+import re
+
+
 def parse_duration(text: str) -> int:
-    """Convierte duraciones como "1h30m" o "45s" a segundos."""
+    """Convierte componentes enteros no negativos en orden h, m, s a segundos.
+
+    Lanza ValueError si la entrada no contiene una duración válida.
+    """
+    match = (
+        re.fullmatch(r"(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", text)
+        if isinstance(text, str)
+        else None
+    )
+    if match is None or not any(match.groups()):
+        raise ValueError(
+            f"Duración inválida: {text!r}. Usá el formato '1h30m45s' "
+            "con al menos un componente en orden h, m, s."
+        )
     total = 0
-    for unidad, factor in (("h", 3600), ("m", 60), ("s", 1)):
-        if unidad in text:
-            numero, text = text.split(unidad)
-            total += int(numero) * factor
+    for numero, factor in zip(match.groups(), (3600, 60, 1)):
+        valor = 0
+        # Convertir en bloques evita el límite de dígitos de int() en Python.
+        for inicio in range(0, len(numero or ""), 9):
+            bloque = numero[inicio : inicio + 9]
+            valor = valor * 10 ** len(bloque) + int(bloque)
+        total += valor * factor
     return total
