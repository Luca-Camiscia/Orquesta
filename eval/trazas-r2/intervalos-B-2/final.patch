diff --git a/codigo.py b/codigo.py
index 19b1861..0f12b0c 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,8 +1,8 @@
 def merge_intervals(intervals):
     """Une intervalos cerrados [a, b] que se solapan."""
     result = []
-    for a, b in intervals:
-        if result and a < result[-1][1]:
+    for a, b in sorted(intervals, key=lambda interval: interval[0]):
+        if result and a <= result[-1][1]:
             result[-1][1] = max(result[-1][1], b)
         else:
             result.append([a, b])
diff --git a/test_visible.py b/test_visible.py
index d20886e..75fdd85 100644
--- a/test_visible.py
+++ b/test_visible.py
@@ -3,3 +3,51 @@ from codigo import merge_intervals
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+def test_extremos_compartidos():
+    assert merge_intervals([[1, 2], [2, 3], [3, 4]]) == [[1, 4]]
+
+
+def test_desordenados_con_intervalo_puente():
+    assert merge_intervals([[5, 7], [1, 3], [2, 6]]) == [[1, 7]]
+
+
+def test_desordenados_con_intervalo_contenido():
+    assert merge_intervals([[2, 3], [1, 5]]) == [[1, 5]]
+
+
+def test_intervalos_puntuales_duplicados():
+    assert merge_intervals([[2, 2], [2, 2]]) == [[2, 2]]
+
+
+def test_desordenados_separados():
+    assert merge_intervals([[5, 7], [1, 3]]) == [[1, 3], [5, 7]]
+
+
+def test_entrada_vacia():
+    assert merge_intervals([]) == []
+
+
+def test_unico_intervalo():
+    assert merge_intervals([[1, 2]]) == [[1, 2]]
+
+
+def test_coordenadas_negativas():
+    assert merge_intervals([[-5, -1], [-3, 2]]) == [[-5, 2]]
+
+
+def test_extremos_compartidos_flotantes():
+    assert merge_intervals([[1.5, 3.5], [3.5, 5.0]]) == [[1.5, 5.0]]
+
+
+def test_intervalos_puntuales_disjuntos():
+    assert merge_intervals([[1, 1], [3, 3]]) == [[1, 1], [3, 3]]
+
+
+def test_no_muta_entrada():
+    intervals = [[5, 7], [1, 3], [2, 6]]
+    original = [interval[:] for interval in intervals]
+
+    assert merge_intervals(intervals) == [[1, 7]]
+    assert intervals == original
