@@ -0,0 +1,41 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"abc"', ["abc"]),
+        ('"a""b",c', ['a"b', "c"]),
+        ('"a,""b""",c', ['a,"b"', "c"]),
+        ('""""', ['"']),
+        ('""""""', ['""']),
+        ('"a""""b"', ['a""b']),
+        ('""', [""]),
+        ('"",,""', ["", "", ""]),
+        ("", [""]),
+        ("a,", ["a", ""]),
+        (",a,", ["", "a", ""]),
+        (' a ," b "', [" a ", " b "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\nb",c', ["a\nb", "c"]),
+        ('"a\rb",c', ["a\rb", "c"]),
+        ("a,b\r\n", ["a", "b"]),
+        ('"a,b"\r\n', ["a,b"]),
+        ('"ñ,á",β', ["ñ,á", "β"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    ['"abc', '"""', 'a"', 'a"b,c', '"a"b,c', '"a" ,b', "a\r\nb", "a\nb"],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
