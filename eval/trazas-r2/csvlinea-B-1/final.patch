@@ -1,3 +1,33 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Separa un registro CSV (RFC 4180); lanza ValueError si está mal formado."""
+    if line.endswith("\r\n"):
+        line = line[:-2]
+
+    fields = []
+    field = []
+    state = "unquoted"
+    for char in line:
+        if state == "quoted":
+            if char == '"':
+                state = "closed"
+            else:
+                field.append(char)
+        elif char == ",":
+            fields.append("".join(field))
+            field = []
+            state = "unquoted"
+        elif char == '"':
+            if state == "closed":
+                field.append('"')
+            elif field:
+                raise ValueError("Comilla dentro de un campo sin entrecomillar")
+            state = "quoted"
+        elif state == "closed" or char in "\r\n":
+            raise ValueError("Carácter inválido fuera de un campo entrecomillado")
+        else:
+            field.append(char)
+
+    if state == "quoted":
+        raise ValueError("Campo entrecomillado sin cerrar")
+    fields.append("".join(field))
+    return fields
