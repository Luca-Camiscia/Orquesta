@@ -1,3 +1,15 @@
+from operator import index
+
+
 def moving_average(xs, k):
-    """Promedio móvil de ventana k."""
-    return [sum(xs[i:i + k]) / k for i in range(len(xs))]
+    """Promedios de ventanas completas; k debe ser un entero positivo, no booleano.
+
+    Devuelve [] si no hay ventanas completas. Un k de tipo inválido produce
+    TypeError; un k no positivo produce ValueError.
+    """
+    if isinstance(k, bool):
+        raise TypeError("k debe ser un entero, no un booleano")
+    k = index(k)
+    if k <= 0:
+        raise ValueError("k debe ser positivo")
+    return [sum(xs[i:i + k]) / k for i in range(len(xs) - k + 1)]
diff --git a/test_visible.py b/test_visible.py
index d290b42..d2597f6 100644
--- a/test_visible.py
+++ b/test_visible.py
@@ -1,5 +1,37 @@
+import pytest
+
 from codigo import moving_average
 
 
 def test_basico():
     assert moving_average([1, 2, 3, 4], 2) == [1.5, 2.5, 3.5]
+
+
+@pytest.mark.parametrize(
+    "xs, k, esperado",
+    [
+        ([], 1, []),
+        ([], 3, []),
+        ([5], 1, [5.0]),
+        ([1, 2, 3], 1, [1.0, 2.0, 3.0]),
+        ([1, 2, 3], 3, [2.0]),
+        ([1, 2, 3], 4, []),
+        ((-1.5, 0.5, 2.5), 2, [-0.5, 1.5]),
+    ],
+)
+def test_ventanas_completas_en_casos_borde(xs, k, esperado):
+    assert moving_average(xs, k) == esperado
+
+
+@pytest.mark.parametrize("xs", [[], [1, 2, 3]])
+@pytest.mark.parametrize("k", [0, -1, -4])
+def test_rechaza_ventanas_no_positivas(xs, k):
+    with pytest.raises(ValueError):
+        moving_average(xs, k)
+
+
+@pytest.mark.parametrize("xs", [[], [1, 2, 3]])
+@pytest.mark.parametrize("k", [1.0, 1.5, "2", None, True, False])
+def test_rechaza_ventanas_de_tipo_invalido(xs, k):
+    with pytest.raises(TypeError):
+        moving_average(xs, k)
