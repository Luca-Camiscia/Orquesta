 def moving_average(xs, k):
-    """Promedio móvil de ventana k."""
-    return [sum(xs[i:i + k]) / k for i in range(len(xs))]
+    """Promedia ventanas completas; k debe ser un entero positivo, no booleano.
+
+    Devuelve [] si no hay una ventana completa.
+    """
+    if isinstance(k, bool) or not isinstance(k, int):
+        raise TypeError("k debe ser un entero positivo")
+    if k <= 0:
+        raise ValueError("k debe ser mayor que cero")
+    return [sum(xs[i:i + k]) / k for i in range(len(xs) - k + 1)]
