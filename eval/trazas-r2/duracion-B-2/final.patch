@@ -0,0 +1,63 @@
+import pytest
+
+from codigo import parse_duration
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("1h", 3600),
+        ("30m", 1800),
+        ("45s", 45),
+        ("1h30m", 5400),
+        ("1h45s", 3645),
+        ("2m45s", 165),
+        ("1h2m3s", 3723),
+        ("0h", 0),
+        ("0m", 0),
+        ("0s", 0),
+        ("0h30m", 1800),
+        ("0h0m0s", 0),
+        ("001h02m03s", 3723),
+        ("90m", 5400),
+    ],
+)
+def test_accepts_ordered_duration_components(text, expected):
+    assert parse_duration(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "basura",
+        "123",
+        "h",
+        "m",
+        "s",
+        "1hbasura",
+        "1h30",
+        "45sx",
+        "1h1h",
+        "1m2m",
+        "1s2s",
+        "2m1h",
+        "1s2m",
+        "1s2m3h",
+        "1s2h",
+        "-1h",
+        "+1m",
+        "1.5h",
+        "1H",
+        " 1h",
+        "1h ",
+        "1h 2m",
+        "1s\n",
+        None,
+        45,
+        b"45s",
+    ],
+)
+def test_rejects_invalid_duration_with_clear_error(text):
+    with pytest.raises(ValueError, match="[Dd]uraci[oó]n"):
+        parse_duration(text)
