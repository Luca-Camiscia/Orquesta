-    return total
+    """Convierte enteros no negativos con unidades h, m, s en orden a segundos."""
+    match = (
+        _DURATION_PATTERN.fullmatch(text)
+        if isinstance(text, str)
+        else None
+    )
+    if match is None or not text:
+        raise ValueError("Duración inválida: usá números enteros con h, m, s en orden")
+    return sum(
+        int(numero or 0) * factor
+        for numero, factor in zip(match.groups(), (3600, 60, 1))
