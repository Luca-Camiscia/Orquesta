--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,10 @@
 def moving_average(xs, k):
-    """Promedio móvil de ventana k."""
-    return [sum(xs[i:i + k]) / k for i in range(len(xs))]
+    """Promedios de ventanas completas; k debe ser un entero positivo, no bool.
+
+    Devuelve [] si no hay ventanas completas.
+    """
+    if isinstance(k, bool) or not isinstance(k, int):
+        raise TypeError("k debe ser un entero")
+    if k <= 0:
+        raise ValueError("k debe ser positivo")
+    return [sum(xs[i:i + k]) / k for i in range(len(xs) - k + 1)]
diff --git a/test_visible.py b/test_visible.py
