@@ -1,5 +1,37 @@
 from codigo import merge_intervals
+import pytest
 
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+@pytest.mark.parametrize(
+    "intervals, expected",
+    [
+        ([[1, 3], [3, 6]], [[1, 6]]),
+        ([[5, 7], [1, 3], [2, 6]], [[1, 7]]),
+        ([[8, 10], [1, 3]], [[1, 3], [8, 10]]),
+        ([[1, 10], [2, 3], [9, 12]], [[1, 12]]),
+        ([[4, 5], [1, 2], [2, 4]], [[1, 5]]),
+        ([[2, 2], [2, 2]], [[2, 2]]),
+        ([[-5, -1], [-2, 2]], [[-5, 2]]),
+        ([[0.5, 1.5], [1.5, 2.5]], [[0.5, 2.5]]),
+        ([[0.5, 1.5], [1.75, 2.5]], [[0.5, 1.5], [1.75, 2.5]]),
+        ([], []),
+    ],
+    ids=[
+        "extremo_compartido",
+        "solapamiento_desordenado",
+        "separados_desordenados",
+        "contenido_y_extension",
+        "union_transitiva",
+        "puntos_duplicados",
+        "solapamiento_negativos",
+        "extremo_compartido_flotantes",
+        "separados_flotantes",
+        "vacio",
+    ],
+)
+def test_intervalos_cerrados(intervals, expected):
+    assert merge_intervals(intervals) == expected
