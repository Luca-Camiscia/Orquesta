--- /dev/null
+++ b/test_paginate.py
@@ -0,0 +1,35 @@
+import pytest
+
+from codigo import paginate
+
+
+@pytest.mark.parametrize(
+    "items, page, per_page, expected",
+    [
+        (list(range(10)), 2, 3, [3, 4, 5]),
+        (list(range(10)), 4, 3, [9]),
+        (list(range(6)), 2, 3, [3, 4, 5]),
+        (list(range(6)), 3, 3, []),
+        (list(range(10)), 100, 3, []),
+        ([], 1, 3, []),
+        ([0, 1], 1, 3, [0, 1]),
+        ([0, 1], 2, 1, [1]),
+    ],
+)
+def test_paginas_y_limites(items, page, per_page, expected):
+    assert paginate(items, page, per_page) == expected
+
+
+@pytest.mark.parametrize("page, per_page", [(0, 3), (-1, 3), (1, 0), (1, -3)])
+@pytest.mark.parametrize("items", [[], list(range(10))])
+def test_rechaza_valores_no_positivos(items, page, per_page):
+    with pytest.raises(ValueError):
+        paginate(items, page, per_page)
+
+
+@pytest.mark.parametrize("value", [True, False, 1.0, 1.5, "1", None])
+@pytest.mark.parametrize("parameter", ["page", "per_page"])
+def test_rechaza_tipos_invalidos(parameter, value):
+    arguments = {"page": 1, "per_page": 3, parameter: value}
+    with pytest.raises(TypeError):
+        paginate([0, 1, 2], **arguments)
