+import re
+import unicodedata
+
+
 def slugify(text: str) -> str:
-    """Convierte un título en un slug para URLs."""
-    return text.lower().replace(" ", "-")
+    """Convierte un título str en un slug ASCII sin acentos para URLs.
+
+    Expande ligaduras y ordinales; los demás símbolos son separadores.
+    """
+    # NFD evita convertir superíndices y fracciones en cifras contiguas.
+    normalized = unicodedata.normalize("NFD", text)
+    text = "".join(char for char in normalized if not unicodedata.combining(char))
+    text = (
+        text.lower()
+        .replace("æ", "ae")
+        .replace("œ", "oe")
+        .replace("º", "o")
+        .replace("ª", "a")
+    )
+    return re.sub(r"[^a-z0-9]+", "-", text).strip("-")
