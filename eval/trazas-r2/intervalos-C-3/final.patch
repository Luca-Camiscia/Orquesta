+import pytest
+
 from codigo import merge_intervals
 
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+def test_extremos_compartidos():
+    assert merge_intervals([[1, 2], [2, 3], [3, 3]]) == [[1, 3]]
+
+
+def test_solapados_desordenados():
+    assert merge_intervals([[8, 10], [1, 3], [2, 6]]) == [[1, 6], [8, 10]]
+
+
+def test_separados_desordenados():
+    assert merge_intervals([[8, 10], [1, 3]]) == [[1, 3], [8, 10]]
+
+
+@pytest.mark.parametrize("intervals, expected", [
+    ([], []),
+    ([[2, 2]], [[2, 2]]),
+    ([[1, 10], [2, 3], [9, 12]], [[1, 12]]),
+    ([[1, 3], [1, 3], [1, 2]], [[1, 3]]),
+    ([[3, 4], [1, 2]], [[1, 2], [3, 4]]),
+    ([[-1, 0], [-3, -1], [0, 0]], [[-3, 0]]),
+    ([[0.5, 1.5], [1.5, 2.5]], [[0.5, 2.5]]),
+    ([[2, 2], [1, 1]], [[1, 1], [2, 2]]),
+])
+def test_casos_borde(intervals, expected):
+    assert merge_intervals(intervals) == expected
+
+
+@pytest.mark.parametrize("intervals", [
+    [[3, 1]],
+    [[1, 10], [4, 2]],
+    [[float("nan"), 3]],
+    [[1, float("nan")]],
+    [[1, 10], [4, float("nan")]],
+    [[]],
+    [[1]],
+    [[1, 2, 3]],
+])
+def test_rechaza_intervalos_invalidos(intervals):
+    with pytest.raises(ValueError):
+        merge_intervals(intervals)
+
+
+@pytest.mark.parametrize("intervals", [None, [None], [[None, 1]], [[1, "2"]]])
+def test_rechaza_entradas_no_iterables_o_extremos_no_comparables(intervals):
+    with pytest.raises(TypeError):
+        merge_intervals(intervals)
+
+
+def test_no_modifica_ni_comparte_listas_con_la_entrada():
+    intervals = [[8, 10], [2, 6], [1, 3]]
+    result = merge_intervals(intervals)
+    assert intervals == [[8, 10], [2, 6], [1, 3]]
+    assert result == [[1, 6], [8, 10]]
+    result[0][1] = 99
+    result[1][0] = 99
+    assert intervals == [[8, 10], [2, 6], [1, 3]]
+
+
+def test_acepta_generador_de_tuplas():
+    intervals = ((a, b) for a, b in [(2, 4), (1, 2)])
+    assert merge_intervals(intervals) == [[1, 4]]
