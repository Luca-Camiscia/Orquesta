 def merge_intervals(intervals):
-    """Une intervalos cerrados [a, b] que se solapan."""
-    result = []
+    """Une intervalos cerrados [a, b] sin modificar la entrada.
+
+    Cada intervalo debe tener dos extremos comparables con a <= b.
+    Lanza ValueError si no tiene dos extremos o no cumple a <= b,
+    y TypeError si la entrada no es iterable o los extremos no son comparables.
+    """
+    validated = []
     for a, b in intervals:
-        if result and a < result[-1][1]:
+        if not a <= b:
+            raise ValueError("Los extremos del intervalo deben cumplir a <= b")
+        validated.append((a, b))
+
+    result = []
+    for a, b in sorted(validated, key=lambda interval: interval[0]):
+        if result and a <= result[-1][1]:
             result[-1][1] = max(result[-1][1], b)
         else:
             result.append([a, b])
