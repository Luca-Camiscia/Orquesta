+++ b/test_csv_line.py
@@ -0,0 +1,35 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('"a,b",c', ["a,b", "c"]),
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a","b","c"', ["a", "b", "c"]),
+        ('"a""b,c",d', ['a"b,c', "d"]),
+        ('""""', ['"']),
+        ('"a""",b', ['a"', "b"]),
+        ('', [""]),
+        (',,"",', ["", "", "", ""]),
+        (' a ," b "', [" a ", " b "]),
+        ('"uno\r\ndos",tres', ["uno\r\ndos", "tres"]),
+        ('"uno\ndos\rtres"', ["uno\ndos\rtres"]),
+        ('a,"b,c"\r\n', ["a", "b,c"]),
+        ('a,\r\n', ["a", ""]),
+        ('"ñ,á",β', ["ñ,á", "β"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    ['"sin cierre', 'a"b,c', '"a"b,c', '"a" ,b', 'a\r\nb,c', 'a\nb', 'a\rb'],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
