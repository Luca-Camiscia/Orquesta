diff --git a/codigo.py b/codigo.py
index 7398ad6..d74a62c 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,39 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Parsea un registro CSV (CRLF final opcional); rechaza CSV inválido."""
+    if line.endswith("\r\n"):
+        line = line[:-2]
+
+    fields = []
+    field = []
+    state = "start"
+    for char in line:
+        if state == "quoted":
+            if char == '"':
+                state = "closed"
+            else:
+                field.append(char)
+        elif char == ",":
+            fields.append("".join(field))
+            field = []
+            state = "start"
+        elif char == '"':
+            if state == "start":
+                state = "quoted"
+            elif state == "closed":
+                # Dos comillas dentro del campo representan una comilla literal.
+                field.append('"')
+                state = "quoted"
+            else:
+                raise ValueError("Comilla en un campo sin entrecomillar")
+        elif state == "closed":
+            raise ValueError("Texto después de la comilla de cierre")
+        elif char in "\r\n":
+            raise ValueError("Salto de línea fuera de un campo entrecomillado")
+        else:
+            field.append(char)
+            state = "unquoted"
+
+    if state == "quoted":
+        raise ValueError("Campo entrecomillado sin cierre")
+    fields.append("".join(field))
+    return fields
diff --git a/test_csv_line.py b/test_csv_line.py
