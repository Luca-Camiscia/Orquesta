+import pytest
+
 from codigo import merge_intervals
 
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+@pytest.mark.parametrize(
+    "intervals, expected",
+    [
+        ([[1, 3], [3, 5]], [[1, 5]]),
+        ([[5, 7], [1, 6]], [[1, 7]]),
+        ([[1, 2], [4, 5], [2, 4]], [[1, 5]]),
+        ([[2, 3], [1, 10]], [[1, 10]]),
+        ([[3, 3], [1, 3], [3, 5]], [[1, 5]]),
+        ([[1, 3], [1, 3]], [[1, 3]]),
+        ([[-2, -1], [-4, -2], [1, 2]], [[-4, -1], [1, 2]]),
+        ([[5, 6], [1, 2]], [[1, 2], [5, 6]]),
+        ([], []),
+        ([[1, 1]], [[1, 1]]),
+    ],
+)
+def test_union_intervalos_cerrados(intervals, expected):
+    assert merge_intervals(intervals) == expected
