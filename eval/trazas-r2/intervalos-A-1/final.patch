@@ -0,0 +1,20 @@
+import pytest
+
+from codigo import merge_intervals
+
+
+@pytest.mark.parametrize(
+    "intervals, expected",
+    [
+        ([[1, 3], [3, 5]], [[1, 5]]),
+        ([[5, 8], [1, 6]], [[1, 8]]),
+        ([[8, 10], [1, 3]], [[1, 3], [8, 10]]),
+        ([[3, 5], [1, 3], [5, 7]], [[1, 7]]),
+        ([[1, 10], [2, 3], [9, 12]], [[1, 12]]),
+        ([[1, 1], [1, 2], [2, 2]], [[1, 2]]),
+        ([[1, 2], [3, 4]], [[1, 2], [3, 4]]),
+        ([], []),
+    ],
+)
+def test_union_de_intervalos_cerrados(intervals, expected):
+    assert merge_intervals(intervals) == expected
