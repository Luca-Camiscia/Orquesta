@@ -0,0 +1,38 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"abc"', ["abc"]),
+        ('"a""b",c', ['a"b', "c"]),
+        ('"a,""b""",c', ['a,"b"', "c"]),
+        ('""""', ['"']),
+        ('"","",', ["", "", ""]),
+        ("", [""]),
+        (",a,,", ["", "a", "", ""]),
+        (' a ," b,c "', [" a ", " b,c "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\rb\nc",d', ["a\rb\nc", "d"]),
+        ("a,b\r\n", ["a", "b"]),
+        ('a,"b,c"\r\n', ["a", "b,c"]),
+        ('"a\r\n"\r\n', ["a\r\n"]),
+        ("a,b\n", ["a", "b"]),
+        ('ñ,"café, té"', ["ñ", "café, té"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    ['"a,b', 'a"b,c', '"a"b,c', '"a" ,b', '"""', "a\nb,c", "a\rb,c"],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
