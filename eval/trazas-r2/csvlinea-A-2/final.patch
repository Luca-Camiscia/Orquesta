diff --git a/codigo.py b/codigo.py
index 7398ad6..561290c 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,47 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Separa un registro CSV (RFC 4180); rechaza sintaxis inválida.
+
+    Acepta un terminador opcional CRLF o LF y conserva saltos entre comillas.
+    """
+    if line.endswith("\r\n"):
+        line = line[:-2]
+    elif line.endswith("\n"):
+        line = line[:-1]
+
+    fields = []
+    field = []
+    in_quotes = False
+    quote_closed = False
+    i = 0
+    while i < len(line):
+        char = line[i]
+        if in_quotes:
+            if char == '"':
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    field.append('"')
+                    i += 1
+                else:
+                    in_quotes = False
+                    quote_closed = True
+            else:
+                field.append(char)
+        elif char == ",":
+            fields.append("".join(field))
+            field = []
+            quote_closed = False
+        elif quote_closed:
+            raise ValueError("Contenido después del cierre de comillas")
+        elif char == '"':
+            if field:
+                raise ValueError("Comillas dentro de un campo sin citar")
+            in_quotes = True
+        elif char in "\r\n":
+            raise ValueError("Salto de línea fuera de un campo entre comillas")
+        else:
+            field.append(char)
+        i += 1
+
+    if in_quotes:
+        raise ValueError("Campo entre comillas sin cerrar")
+    fields.append("".join(field))
+    return fields
