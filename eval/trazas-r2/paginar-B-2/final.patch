diff --git a/test_visible.py b/test_visible.py
index 635458a..309d344 100644
--- a/test_visible.py
+++ b/test_visible.py
@@ -1,5 +1,33 @@
+import pytest
+
 from codigo import paginate
 
 
 def test_primera_pagina():
     assert paginate(list(range(10)), 1, 3) == [0, 1, 2]
+
+
+@pytest.mark.parametrize("page, expected", [
+    (2, [3, 4, 5]),
+    (3, [6, 7, 8]),
+    (4, [9]),
+    (5, []),
+])
+def test_paginas_subsiguientes(page, expected):
+    assert paginate(list(range(10)), page, 3) == expected
+
+
+def test_coleccion_vacia():
+    assert paginate([], 1, 3) == []
+
+
+@pytest.mark.parametrize("page", [0, -1])
+def test_rechaza_pagina_invalida(page):
+    with pytest.raises(ValueError):
+        paginate([1, 2, 3, 4, 5], page, 2)
+
+
+@pytest.mark.parametrize("per_page", [0, -1])
+def test_rechaza_tamano_invalido(per_page):
+    with pytest.raises(ValueError):
+        paginate([1, 2, 3, 4, 5], 1, per_page)
