 def paginate(items, page, per_page):
-    """Devuelve la página `page` (empezando en 1) de `items`."""
-    start = page * per_page
+    """Devuelve la página `page` (desde 1) de una secuencia rebanable.
+
+    Lanza ValueError si `page` o `per_page` no son positivos.
+    """
+    if page < 1:
+        raise ValueError("page debe ser mayor o igual a 1")
+    if per_page <= 0:
+        raise ValueError("per_page debe ser mayor que 0")
+    start = (page - 1) * per_page
     return items[start:start + per_page]
diff --git a/test_visible.py b/test_visible.py
index 635458a..1c71462 100644
--- a/test_visible.py
+++ b/test_visible.py
@@ -1,5 +1,26 @@
+import pytest
+
 from codigo import paginate
 
 
 def test_primera_pagina():
     assert paginate(list(range(10)), 1, 3) == [0, 1, 2]
+
+
+@pytest.mark.parametrize(
+    "items, page, per_page, expected",
+    [
+        (list(range(10)), 2, 3, [3, 4, 5]),
+        (list(range(10)), 4, 3, [9]),
+        (list(range(10)), 5, 3, []),
+        ([], 1, 3, []),
+    ],
+)
+def test_paginas_y_limites(items, page, per_page, expected):
+    assert paginate(items, page, per_page) == expected
+
+
+@pytest.mark.parametrize("page, per_page", [(0, 3), (-1, 3), (1, 0), (1, -2)])
+def test_rechaza_valores_no_positivos(page, per_page):
+    with pytest.raises(ValueError):
+        paginate(list(range(10)), page, per_page)
