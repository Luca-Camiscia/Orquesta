@@ -0,0 +1,74 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"aaa","b""bb","ccc"', ["aaa", 'b"bb', "ccc"]),
+        ('"a,""b""",c', ['a,"b"', "c"]),
+        ('""""', ['"']),
+        ('"abc"', ["abc"]),
+        ('"",""', ["", ""]),
+        ("", [""]),
+        (",a,,", ["", "a", "", ""]),
+        (" a , b ", [" a ", " b "]),
+        ('" a ", b ', [" a ", " b "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\nb\rc",d', ["a\nb\rc", "d"]),
+        ('a,"b,c"\r\n', ["a", "b,c"]),
+        ("a,b\r\n", ["a", "b"]),
+        (",\r\n", ["", ""]),
+        ("\r\n", [""]),
+        ('""\r\n', [""]),
+        ('"a\r\n"\r\n', ["a\r\n"]),
+        ('"\r","\n"', ["\r", "\n"]),
+        ('"a"""', ['a"']),
+        ('"""a"', ['"a']),
+        ('"a",', ["a", ""]),
+        ('"a","",b', ["a", "", "b"]),
+        ('á,"niño,😀"', ["á", "niño,😀"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"abc',
+        'a,"b,c',
+        'a"b,c',
+        '"a"b,c',
+        '"a" ,b',
+        "a\nb,c",
+        "a\rb,c",
+        '"',
+        '"""',
+        '"a""',
+        '"a\r\n',
+        ' "a",b',
+        '"a\\"b",c',
+        "a,b\n",
+        "a,b\r",
+        '"a"\n',
+        '"a"\r',
+        "a,b\r\nc,d",
+        '"a"\r\n"b"\r\n',
+        "a,b\r\n\r\n",
+    ],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
+
+
+@pytest.mark.parametrize("codepoint", [*range(10), 11, 12, *range(14, 32), 127])
+@pytest.mark.parametrize("template", ["a{}b", '"a{}b"'])
+def test_rejects_non_text_ascii_controls(codepoint, template):
+    with pytest.raises(ValueError):
+        parse_csv_line(template.format(chr(codepoint)))
