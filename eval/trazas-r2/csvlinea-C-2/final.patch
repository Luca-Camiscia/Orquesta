diff --git a/codigo.py b/codigo.py
index 7398ad6..41cd7d7 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,49 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Parsea un registro RFC 4180, con CRLF final opcional.
+
+    Conserva texto Unicode, espacios y saltos dentro de comillas; rechaza
+    CSV mal formado y controles ASCII inválidos con ValueError.
+    El registro completo debe estar en ``line``.
+    """
+    if any(
+        (ord(char) < 32 and char not in "\r\n") or char == "\x7f"
+        for char in line
+    ):
+        raise ValueError("Carácter de control inválido en el registro")
+
+    if line.endswith("\r\n"):
+        line = line[:-2]
+
+    fields = []
+    i = 0
+    while True:
+        field = []
+        if i < len(line) and line[i] == '"':
+            i += 1
+            while i < len(line):
+                char = line[i]
+                i += 1
+                if char == '"':
+                    if i < len(line) and line[i] == '"':
+                        field.append('"')
+                        i += 1
+                    else:
+                        break
+                else:
+                    field.append(char)
+            else:
+                raise ValueError("Campo entre comillas sin cierre")
+
+            if i < len(line) and line[i] != ",":
+                raise ValueError("Carácter inválido después de las comillas de cierre")
+        else:
+            while i < len(line) and line[i] != ",":
+                if line[i] in '"\r\n':
+                    raise ValueError("Comillas o salto de línea en un campo sin comillas")
+                field.append(line[i])
+                i += 1
+
+        fields.append("".join(field))
+        if i == len(line):
+            return fields
+        i += 1
