+import pytest
+
 from codigo import merge_intervals
 
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+def test_extremos_compartidos():
+    assert merge_intervals([[1, 3], [3, 3], [3, 6]]) == [[1, 6]]
+
+
+def test_intervalos_desordenados_con_puente():
+    assert merge_intervals([[5, 7], [1, 3], [3, 5], [9, 10]]) == [[1, 7], [9, 10]]
+
+
+def test_intervalos_contenidos_desordenados():
+    assert merge_intervals([[3, 4], [1, 10], [6, 8]]) == [[1, 10]]
+
+
+def test_entrada_vacia():
+    assert merge_intervals([]) == []
+
+
+@pytest.mark.parametrize(
+    "intervals, expected",
+    [
+        ([[1, 5]], [[1, 5]]),
+        ([[1, 3], [1, 3]], [[1, 3]]),
+        ([[1, 2], [5, 6]], [[1, 2], [5, 6]]),
+        ([[-5, -1], [-2, 3]], [[-5, 3]]),
+        ([[1.0, 2.5], [2.5, 4.0]], [[1.0, 4.0]]),
+        ([(1, 3), (2, 5)], [[1, 5]]),
+        ([[1, 3], [1, 6]], [[1, 6]]),
+        ([[1, 6], [1, 3]], [[1, 6]]),
+    ],
+    ids=[
+        "unico",
+        "duplicados",
+        "disjuntos",
+        "negativos",
+        "flotantes",
+        "tuplas",
+        "igual_inicio_fin_creciente",
+        "igual_inicio_fin_decreciente",
+    ],
+)
+def test_casos_borde(intervals, expected):
+    assert merge_intervals(intervals) == expected
