diff --git a/test_visible.py b/test_visible.py
index d20886e..6c5bebb 100644
--- a/test_visible.py
+++ b/test_visible.py
@@ -3,3 +3,28 @@ from codigo import merge_intervals
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+def test_extremos_compartidos():
+    assert merge_intervals([[1, 3], [3, 5], [5, 5]]) == [[1, 5]]
+
+
+def test_intervalos_desordenados():
+    assert merge_intervals([[8, 10], [2, 6], [1, 3]]) == [[1, 6], [8, 10]]
+
+
+def test_intervalo_puente_desordenado():
+    assert merge_intervals([[1, 2], [4, 5], [2, 4]]) == [[1, 5]]
+
+
+def test_intervalos_contenidos_y_duplicados():
+    assert merge_intervals([[-3, 5], [-1, 2], [-3, 5]]) == [[-3, 5]]
+
+
+def test_intervalos_separados():
+    assert merge_intervals([[1, 2], [3, 4]]) == [[1, 2], [3, 4]]
+
+
+def test_vacio_y_puntual():
+    assert merge_intervals([]) == []
+    assert merge_intervals([[2, 2]]) == [[2, 2]]
