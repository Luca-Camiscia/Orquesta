@@ -0,0 +1,44 @@
+import pytest
+
+from codigo import parse_duration
+
+
+@pytest.mark.parametrize(
+    ("text", "expected"),
+    [
+        ("1h", 3600),
+        ("30m", 1800),
+        ("45s", 45),
+        ("1h30m", 5400),
+        ("1h45s", 3645),
+        ("30m45s", 1845),
+        ("1h30m45s", 5445),
+        ("0h0m0s", 0),
+        ("0h", 0),
+        ("0m", 0),
+        ("0s", 0),
+        ("01h02m", 3720),
+        ("00h", 0),
+        ("01s", 1),
+        ("90m", 5400),
+    ],
+)
+def test_accepts_ordered_duration_components(text, expected):
+    assert parse_duration(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "", "basura", "123", "h", "1hxyz", "xyz1h", "1h30",
+        "1m2h", "1s2m", "1h2h", "1m2m", "1s2s",
+        "-1h", "+1h", "1.5h", " 1h", "1h ", "1h 2m", "1s\n", "1H",
+        "1M", "1S", "   ", "\t1h", "\n1h", "\t", "\n",
+        "1s1h", "1s2m3h", "1h1s1m", "1h2m3h",
+        None, 45,
+        True, False, 1.5, [], {}, (), set(), b"1h",
+    ],
+)
+def test_rejects_invalid_durations(text):
+    with pytest.raises(ValueError, match="Duración inválida"):
+        parse_duration(text)
