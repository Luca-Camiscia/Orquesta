+import pytest
+
 from codigo import slugify
 
 
 def test_basico():
     assert slugify("Hola Mundo") == "hola-mundo"
+
+
+@pytest.mark.parametrize(
+    ("titulo", "esperado"),
+    [
+        ("ÁÉÍÓÚ áéíóú Ññ Üü", "aeiou-aeiou-nn-uu"),
+        ("¡Canción del año!", "cancion-del-ano"),
+        ("Cafe\u0301 y nin\u0303ez", "cafe-y-ninez"),
+        ("  Árbol\t y\n pingüino  ", "arbol-y-pinguino"),
+        ("¿Qué tal? / Edición_2026 -- versión #2", "que-tal-edicion-2026-version-2"),
+        ("  2026 -- edición 02  ", "2026-edicion-02"),
+        ("", ""),
+        (" \t\n ", ""),
+        (" ¡¿!? --- ", ""),
+        ("🌞🎉", ""),
+    ],
+)
+def test_slug_para_urls_en_espanol(titulo, esperado):
+    assert slugify(titulo) == esperado
+
+
+@pytest.mark.parametrize(
+    ("titulo", "esperado"),
+    [
+        ("España—México", "espana-mexico"),
+        ("niñez–juventud", "ninez-juventud"),
+        ("árbol“azul”", "arbol-azul"),
+        ("niñez\u2028feliz\u2029aquí", "ninez-feliz-aqui"),
+        ("año🌞nuevo", "ano-nuevo"),
+        ("--España—🌞--México--", "espana-mexico"),
+    ],
+)
+def test_separadores_unicode_no_unen_palabras(titulo, esperado):
+    assert slugify(titulo) == esperado
+    assert slugify(esperado) == esperado
+
+
+@pytest.mark.parametrize("titulo", [None, 0, 1.5, True, b"hola", [], {}])
+def test_rechaza_entradas_que_no_son_texto(titulo):
+    with pytest.raises(TypeError):
+        slugify(titulo)
