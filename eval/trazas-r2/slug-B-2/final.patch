 from codigo import slugify
+import pytest
 
 
 def test_basico():
     assert slugify("Hola Mundo") == "hola-mundo"
+
+
+@pytest.mark.parametrize(
+    "titulo, esperado",
+    [
+        ("¡Hola, España! ¿Qué tal?", "hola-espana-que-tal"),
+        ("ÁÉÍÓÚ Ñ Ü", "aeiou-n-u"),
+        ("Nin\u0303o y cancio\u0301n", "nino-y-cancion"),
+        ("  Canción\t del\n año 2026  ", "cancion-del-ano-2026"),
+        ("Guía / Python: versión_3 -- fácil", "guia-python-version-3-facil"),
+        ("tema—subtema", "tema-subtema"),
+        ("tema–subtema", "tema-subtema"),
+        ("tema«subtema»", "tema-subtema"),
+        ("tema“subtema”", "tema-subtema"),
+        ("¡Hola!¿Qué tal?", "hola-que-tal"),
+        ("currículum vitæ", "curriculum-vitae"),
+        ("ex æquo", "ex-aequo"),
+        ("œuvre", "oeuvre"),
+        ("Æ Œ", "ae-oe"),
+        ("1.ª y 1.º", "1-a-y-1-o"),
+        ("", ""),
+        ("  ¡¿---?!  ", ""),
+        ("🎉✨", ""),
+    ],
+)
+def test_slug_para_urls(titulo, esperado):
+    assert slugify(titulo) == esperado
+
+
+@pytest.mark.parametrize("titulo", [None, 123])
+def test_rechaza_entradas_no_string(titulo):
+    with pytest.raises(TypeError):
+        slugify(titulo)
