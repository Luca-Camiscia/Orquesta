+import pytest
+
 from codigo import merge_intervals
 
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+def test_extremo_compartido():
+    assert merge_intervals([[1, 3], [3, 6]]) == [[1, 6]]
+
+
+def test_intervalos_desordenados():
+    assert merge_intervals([[8, 10], [2, 6], [1, 3]]) == [[1, 6], [8, 10]]
+
+
+def test_union_en_cadena_con_intervalo_contenido():
+    assert merge_intervals([[1, 5], [2, 3], [5, 7], [7, 9]]) == [[1, 9]]
+
+
+def test_intervalos_puntuales():
+    assert merge_intervals([[1, 1], [1, 1], [1, 2], [2, 2]]) == [[1, 2]]
+
+
+@pytest.mark.parametrize("intervals, expected", [
+    ([], []),
+    ([[2, 4]], [[2, 4]]),
+    ([[3, 4], [1, 2]], [[1, 2], [3, 4]]),
+    ([[1, 2], [1, 5], [1, 3]], [[1, 5]]),
+    ([[-1.5, 0.5], [-3, -1.5], [0.5, 2]], [[-3, 2]]),
+    ([[-float("inf"), 0], [0, float("inf")]],
+     [[-float("inf"), float("inf")]]),
+])
+def test_casos_borde(intervals, expected):
+    assert merge_intervals(intervals) == expected
+
+
+def test_acepta_iterador_de_tuplas():
+    assert merge_intervals(iter([(3, 6), (1, 3)])) == [[1, 6]]
+
+
+def test_no_modifica_ni_comparte_intervalos_con_la_entrada():
+    intervals = [[3, 6], [1, 3], [8, 10]]
+    result = merge_intervals(intervals)
+    assert intervals == [[3, 6], [1, 3], [8, 10]]
+    result[0][1] = 100
+    result[1][0] = 0
+    assert intervals == [[3, 6], [1, 3], [8, 10]]
+
+
+@pytest.mark.parametrize("intervals", [
+    [[5, 1]],
+    [[1, 4], [3, 2]],
+    [[float("nan"), 3]],
+    [[1, float("nan")]],
+    [[1, 4], [2, float("nan")]],
+    [[]],
+    [[1]],
+    [[1, 2, 3]],
+])
+def test_rechaza_intervalos_invalidos(intervals):
+    with pytest.raises(ValueError):
+        merge_intervals(intervals)
+
+
+@pytest.mark.parametrize("intervals", [
+    None,
+    [None],
+    [[None, 1]],
+    [[1, "2"]],
+])
+def test_rechaza_entradas_no_comparables(intervals):
+    with pytest.raises(TypeError):
+        merge_intervals(intervals)
