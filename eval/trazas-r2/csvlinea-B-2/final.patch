@@ -0,0 +1,51 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"a","b","c"', ["a", "b", "c"]),
+        ('"a""b",c', ['a"b', "c"]),
+        ('"a,""b""",c', ['a,"b"', "c"]),
+        ('""""', ['"']),
+        ('"",,""', ["", "", ""]),
+        ("", [""]),
+        ("\r\n", [""]),
+        ('á,"é,í","ó""ú"', ["á", "é,í", 'ó"ú']),
+        ("a,,", ["a", "", ""]),
+        (",a,", ["", "a", ""]),
+        (' a ," b,c ", d ', [" a ", " b,c ", " d "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\nb\rc",d', ["a\nb\rc", "d"]),
+        ("a,b\r\n", ["a", "b"]),
+        ('"a,b","c"\r\n', ["a,b", "c"]),
+        ('"a\r\n"\r\n', ["a\r\n"]),
+    ],
+)
+def test_rfc4180_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"a,b',
+        'a,"b',
+        'a"b,c',
+        '"a"b,c',
+        '"a" ,b',
+        ' "a",b',
+        "a\r\nb,c",
+        "a\nb,c",
+        "a\rb,c",
+        "a,b\n",
+        "a,b\r",
+    ],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
