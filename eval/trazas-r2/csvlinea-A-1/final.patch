@@ -0,0 +1,45 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"abc"', ["abc"]),
+        ('"a""b,c",d', ['a"b,c', "d"]),
+        ('""""', ['"']),
+        ('""', [""]),
+        ('', [""]),
+        (',a,,', ["", "a", "", ""]),
+        ('"",a,""', ["", "a", ""]),
+        (' a ," b "', [" a ", " b "]),
+        ('"a\r\nb",c\r\n', ["a\r\nb", "c"]),
+        ('"a\nb",c', ["a\nb", "c"]),
+        ('a,b\r\n', ["a", "b"]),
+        ('"a,b"\r\n', ["a,b"]),
+        ('a,b\n', ["a", "b"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"unterminated',
+        '"a""',
+        'a"b,c',
+        '"a"b,c',
+        '"a" ,c',
+        'a\r\nb,c',
+        'a\nb,c',
+        'a\rb,c',
+    ],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
