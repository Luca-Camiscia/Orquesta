diff --git a/codigo.py b/codigo.py
index 7398ad6..62ea40e 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,47 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Parsea un registro CSV (RFC 4180); acepta terminación CRLF o LF.
+
+    Los registros mal formados generan ValueError.
+    """
+    if line.endswith("\r\n"):
+        line = line[:-2]
+    elif line.endswith("\n"):
+        line = line[:-1]
+
+    fields = []
+    field = []
+    in_quotes = False
+    closed_quote = False
+    i = 0
+    while i < len(line):
+        char = line[i]
+        if in_quotes:
+            if char == '"':
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    field.append('"')
+                    i += 1
+                else:
+                    in_quotes = False
+                    closed_quote = True
+            else:
+                field.append(char)
+        elif char == ",":
+            fields.append("".join(field))
+            field = []
+            closed_quote = False
+        elif closed_quote:
+            raise ValueError("Hay texto después de las comillas de cierre")
+        elif char == '"':
+            if field:
+                raise ValueError("Hay comillas en un campo sin entrecomillar")
+            in_quotes = True
+        elif char in "\r\n":
+            raise ValueError("Hay un salto de línea fuera de un campo entre comillas")
+        else:
+            field.append(char)
+        i += 1
+
+    if in_quotes:
+        raise ValueError("El campo entre comillas no está cerrado")
+    fields.append("".join(field))
+    return fields
diff --git a/test_csv_line.py b/test_csv_line.py
