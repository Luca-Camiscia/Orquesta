+import pytest
+
 from codigo import parse_csv_line
 
 
 def test_simple():
     assert parse_csv_line("a,b,c") == ["a", "b", "c"]
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"a","b","c"', ["a", "b", "c"]),
+        ('"a""b",c', ['a"b', "c"]),
+        ('"""",x', ['"', "x"]),
+        ('"a,""b""",c', ['a,"b"', "c"]),
+        ('"",,""', ["", "", ""]),
+        (",a,,", ["", "a", "", ""]),
+        ("", [""]),
+        (' a ," b,c "', [" a ", " b,c "]),
+        ('"a\r\nb",c\r\n', ["a\r\nb", "c"]),
+        ('"a\nb\rc",d', ["a\nb\rc", "d"]),
+        ("a,b\r\n", ["a", "b"]),
+        ('a,"b"\r\n', ["a", "b"]),
+        ("\r\n", [""]),
+        (",\r\n", ["", ""]),
+        ('""\r\n', [""]),
+        ('"a,b",\r\n', ["a,b", ""]),
+        ('"a"""', ['a"']),
+        ('""""""', ['""']),
+        ('"a\r\n"\r\n', ["a\r\n"]),
+        ('"a",b,"c,d"', ["a", "b", "c,d"]),
+        ('á,"日本語,ñ"', ["á", "日本語,ñ"]),
+    ],
+)
+def test_rfc4180_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"a,b',
+        'a"b,c',
+        '"a"b,c',
+        '"a" ,b',
+        '"a""',
+        "a\nb",
+        "a\rb",
+        "a,b\r\nc,d",
+        ' "a",b',
+        '""x',
+        '"""',
+        '"a\\"b",c',
+        '"a,b\r\n',
+        "a,b\n",
+        "a,b\r",
+        '"a"\n',
+        '"a"\r',
+        "a,b\r\n\r\n",
+        'a,b\r\n"c,d"\r\n',
+    ],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
+
+
+@pytest.mark.parametrize(
+    "control",
+    [chr(code) for code in range(32) if code not in (10, 13)] + ["\x7f"],
+)
+@pytest.mark.parametrize("quoted", [False, True])
+def test_rejects_ascii_controls_excluded_by_rfc4180(control, quoted):
+    field = f"a{control}b"
+    if quoted:
+        field = f'"{field}"'
+    with pytest.raises(ValueError):
+        parse_csv_line(f"x,{field},y\r\n")
