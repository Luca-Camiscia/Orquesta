@@ -0,0 +1,53 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"aaa","b""bb","ccc"', ["aaa", 'b"bb', "ccc"]),
+        ('"a,""b""",c', ['a,"b"', "c"]),
+        ('""""', ['"']),
+        ('""', [""]),
+        ('"a"""', ['a"']),
+        ('"""a",b', ['"a', "b"]),
+        ('"plain"', ["plain"]),
+        ("", [""]),
+        (",,", ["", "", ""]),
+        ('"",a,"",', ["", "a", "", ""]),
+        (' a ," b , c ", d ', [" a ", " b , c ", " d "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\nb",c', ["a\nb", "c"]),
+        ('"a\rb",c', ["a\rb", "c"]),
+        ('a,"b,c"\r\n', ["a", "b,c"]),
+        ("a,b\r\n", ["a", "b"]),
+        ("a,b\n", ["a", "b"]),
+        ('"á,ñ",東京', ["á,ñ", "東京"]),
+        ('"a\\b",c', ["a\\b", "c"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"unclosed',
+        'a,"b',
+        '"a"b,c',
+        'a"b,c',
+        '"a" ,b',
+        "a\nb,c",
+        "a\r\nb,c",
+        '"""',
+        '"""""',
+        "a,b\r",
+    ],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
