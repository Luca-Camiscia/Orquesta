@@ -1,3 +1,44 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Separa un registro CSV; lanza ValueError si está mal formado."""
+    if line.endswith("\r\n"):
+        line = line[:-2]
+    elif line.endswith("\n"):
+        line = line[:-1]
+
+    fields = []
+    field = []
+    in_quotes = False
+    closed_quote = False
+    i = 0
+    while i < len(line):
+        char = line[i]
+        if in_quotes:
+            if char == '"':
+                if i + 1 < len(line) and line[i + 1] == '"':
+                    field.append('"')
+                    i += 1
+                else:
+                    in_quotes = False
+                    closed_quote = True
+            else:
+                field.append(char)
+        elif char == ",":
+            fields.append("".join(field))
+            field = []
+            closed_quote = False
+        elif closed_quote:
+            raise ValueError("Carácter inesperado después de cerrar comillas")
+        elif char == '"':
+            if field:
+                raise ValueError("Comillas dentro de un campo no citado")
+            in_quotes = True
+        elif char in "\r\n":
+            raise ValueError("Salto de línea fuera de un campo citado")
+        else:
+            field.append(char)
+        i += 1
+
+    if in_quotes:
+        raise ValueError("Campo con comillas sin cerrar")
+    fields.append("".join(field))
+    return fields
