+
 def parse_duration(text: str) -> int:
-    """Convierte duraciones como "1h30m" o "45s" a segundos."""
-    total = 0
-    for unidad, factor in (("h", 3600), ("m", 60), ("s", 1)):
-        if unidad in text:
-            numero, text = text.split(unidad)
-            total += int(numero) * factor
-    return total
+    """Convierte enteros no negativos con unidades h, m, s en ese orden."""
+    match = (
+        re.fullmatch(r"(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", text)
+        if isinstance(text, str)
+        else None
+    )
+    if match is None or not match.group(0):
+        raise ValueError(
+            "Duración inválida: usá enteros no negativos con unidades h, m, s "
+            "en ese orden, por ejemplo '1h30m45s'."
+        )
+    return sum(
+        int(numero) * factor
+        for numero, factor in zip(match.groups(), (3600, 60, 1))
+        if numero is not None
+    )
