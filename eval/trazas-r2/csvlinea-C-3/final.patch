diff --git a/codigo.py b/codigo.py
index 7398ad6..8509531 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,50 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Separa un registro RFC 4180, con CRLF final opcional.
+
+    Conserva espacios y saltos dentro de campos entre comillas.
+    Admite texto Unicode, pero rechaza controles ASCII salvo CR y LF
+    dentro de campos entre comillas. Lanza ValueError ante CSV inválido.
+    """
+    if line.endswith("\r\n"):
+        line = line[:-2]
+
+    if any(
+        (char < " " and char not in "\r\n") or char == "\x7f"
+        for char in line
+    ):
+        raise ValueError("Carácter de control ASCII inválido")
+
+    fields = []
+    index = 0
+    length = len(line)
+    while True:
+        field = []
+        if index < length and line[index] == '"':
+            index += 1
+            while index < length:
+                char = line[index]
+                index += 1
+                if char == '"':
+                    if index < length and line[index] == '"':
+                        field.append('"')
+                        index += 1
+                    else:
+                        break
+                else:
+                    field.append(char)
+            else:
+                raise ValueError("Campo entre comillas sin cerrar")
+        else:
+            while index < length and line[index] != ",":
+                char = line[index]
+                if char in '"\r\n':
+                    raise ValueError("Comilla o salto de línea fuera de comillas")
+                field.append(char)
+                index += 1
+
+        fields.append("".join(field))
+        if index == length:
+            return fields
+        if line[index] != ",":
+            raise ValueError("Se esperaba una coma después del campo")
+        index += 1
