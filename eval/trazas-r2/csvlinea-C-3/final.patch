@@ -0,0 +1,77 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"a","b",c', ["a", "b", "c"]),
+        ('"say ""hello""",x', ['say "hello"', "x"]),
+        ('""""', ['"']),
+        ('"a,""b""",c', ['a,"b"', "c"]),
+        ("", [""]),
+        (",,", ["", "", ""]),
+        ('"",a,"",', ["", "a", "", ""]),
+        (' a ," b "', [" a ", " b "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\nb",c', ["a\nb", "c"]),
+        ('"a\rb",c', ["a\rb", "c"]),
+        ("a,b\r\n", ["a", "b"]),
+        ('"a,b"\r\n', ["a,b"]),
+        (",\r\n", ["", ""]),
+        ('"café,ñ",fin', ["café,ñ", "fin"]),
+        ("\r\n", [""]),
+        ('""\r\n', [""]),
+        ('"a\r\n"\r\n', ["a\r\n"]),
+        ('"a"""\r\n', ['a"']),
+        ('"""",', ['"', ""]),
+        ('""""""', ['""']),
+        (' ," ", ', [" ", " ", " "]),
+        (' !# + -~," !# + -~"', [" !# + -~", " !# + -~"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"unclosed',
+        'a,"unclosed',
+        'a"b,c',
+        '"a"b,c',
+        '"a" ,c',
+        '"a""',
+        "a\r\nb,c",
+        "a\nb,c",
+        "a\rb,c",
+        ' "a",b',
+        '"a",b"',
+        '"',
+        '"""',
+        '"unclosed\r\n',
+        '"a"\n',
+        '"a"\r',
+        "a,b\n",
+        "a,b\r",
+        "a,b\r\n\r\n",
+        '"a"\r\n"b"\r\n',
+    ],
+)
+def test_malformed_csv(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
+
+
+@pytest.mark.parametrize(
+    "control",
+    [chr(code) for code in range(32) if code not in (10, 13)] + [chr(127)],
+)
+@pytest.mark.parametrize("template", ['a{}b,c', '"a{}b",c'])
+def test_rejects_ascii_controls_in_fields(control, template):
+    with pytest.raises(ValueError):
+        parse_csv_line(template.format(control))
