@@ -1,5 +1,25 @@
+import pytest
+
 from codigo import paginate
 
 
 def test_primera_pagina():
     assert paginate(list(range(10)), 1, 3) == [0, 1, 2]
+
+
+@pytest.mark.parametrize(
+    "items,page,per_page,expected",
+    [
+        pytest.param(list(range(10)), 2, 3, [3, 4, 5], id="segunda_pagina"),
+        pytest.param(list(range(10)), 3, 3, [6, 7, 8], id="tercera_pagina"),
+        pytest.param(list(range(10)), 4, 3, [9], id="ultima_pagina_parcial"),
+        pytest.param(list(range(10)), 5, 3, [], id="pagina_fuera_de_rango"),
+        pytest.param([], 1, 3, [], id="lista_vacia"),
+        pytest.param([0, 1], 1, 3, [0, 1], id="tamano_mayor_que_lista"),
+        pytest.param(list(range(6)), 2, 3, [3, 4, 5], id="ultima_pagina_completa"),
+        pytest.param(list(range(6)), 3, 3, [], id="despues_de_pagina_completa"),
+        pytest.param([0, 1, 2], 2, 1, [1], id="un_elemento_por_pagina"),
+    ],
+)
+def test_paginas_y_bordes(items, page, per_page, expected):
+    assert paginate(items, page, per_page) == expected
