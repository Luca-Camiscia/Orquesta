+import pytest
+
 from codigo import paginate
 
 
 def test_primera_pagina():
     assert paginate(list(range(10)), 1, 3) == [0, 1, 2]
+
+
+@pytest.mark.parametrize(
+    "items, page, per_page, expected",
+    [
+        (list(range(10)), 2, 3, [3, 4, 5]),
+        (list(range(10)), 3, 3, [6, 7, 8]),
+        (list(range(10)), 4, 3, [9]),
+        (list(range(10)), 5, 3, []),
+        ([], 1, 3, []),
+        ([], 2, 3, []),
+        (list(range(6)), 2, 3, [3, 4, 5]),
+        ([1, 2], 1, 3, [1, 2]),
+    ],
+)
+def test_paginas_y_limites(items, page, per_page, expected):
+    assert paginate(items, page, per_page) == expected
+
+
+@pytest.mark.parametrize("page, per_page", [(0, 2), (-1, 2), (1, 0), (1, -2)])
+@pytest.mark.parametrize("items", [[], [1, 2, 3, 4, 5]])
+def test_parametros_fuera_de_rango(items, page, per_page):
+    with pytest.raises(ValueError):
+        paginate(items, page, per_page)