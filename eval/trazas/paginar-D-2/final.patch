 def paginate(items, page, per_page):
-    """Devuelve la página `page` (empezando en 1) de `items`."""
-    start = page * per_page
+    """Devuelve la página `page` (empezando en 1) de `items`.
+
+    Lanza ValueError si page < 1 o per_page <= 0.
+    """
+    if page < 1:
+        raise ValueError("page debe ser mayor o igual a 1")
+    if per_page <= 0:
+        raise ValueError("per_page debe ser mayor que 0")
+    start = (page - 1) * per_page
     return items[start:start + per_page]
