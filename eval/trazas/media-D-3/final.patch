+from operator import index
+
+
 def moving_average(xs, k):
-    """Promedio móvil de ventana k."""
-    return [sum(xs[i:i + k]) / k for i in range(len(xs))]
+    """Promedia ventanas completas; devuelve [] si no cabe ninguna.
+
+    k debe ser entero (TypeError si no lo es) y positivo (ValueError).
+    """
+    k = index(k)
+    if k <= 0:
+        raise ValueError("k debe ser positivo")
+    return [sum(xs[i:i + k]) / k for i in range(len(xs) - k + 1)]
diff --git a/test_visible.py b/test_visible.py
