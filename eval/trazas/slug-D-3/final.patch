+import pytest
+
 from codigo import slugify
 
 
 def test_basico():
     assert slugify("Hola Mundo") == "hola-mundo"
+
+
+@pytest.mark.parametrize(
+    ("titulo", "esperado"),
+    [
+        ("¡Canción del año!", "cancion-del-ano"),
+        ("ÁÉÍÓÚ Ü Ñ", "aeiou-u-n"),
+        ("¡CANCIÓN DEL AÑO!", "cancion-del-ano"),
+        ("Cancio\u0301n y nin\u0303ez", "cancion-y-ninez"),
+        ("  Guía\tde\nEspaña  ", "guia-de-espana"),
+        ("¿Qué tal? / 2026", "que-tal-2026"),
+        ("--Hola___mundo---", "hola-mundo"),
+        ("Madrid—Barcelona", "madrid-barcelona"),
+        ("Madrid–Barcelona", "madrid-barcelona"),
+        ("d’art", "d-art"),
+        ("½ kilo", "1-2-kilo"),
+        ("2026⁄2027", "2026-2027"),
+        ("Hola\u200bmundo", "hola-mundo"),
+        ("Hola🙂mundo", "hola-mundo"),
+        ("—Árbol…niñez—", "arbol-ninez"),
+        ("\u0301\u0303", ""),
+        ("🙂—½—🙂", "1-2"),
+        ("", ""),
+        (" ¡¿?! / -- ", ""),
+    ],
+)
+def test_slug_para_urls(titulo, esperado):
+    assert slugify(titulo) == esperado
+
+
+@pytest.mark.parametrize("titulo", [None, 123, b"Hola", ["Hola"]])
+def test_rechaza_entradas_que_no_son_cadenas(titulo):
+    with pytest.raises(TypeError):
+        slugify(titulo)