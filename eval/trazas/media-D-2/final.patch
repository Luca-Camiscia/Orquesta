@@ -1,5 +1,35 @@
+import pytest
+
 from codigo import moving_average
 
 
 def test_basico():
     assert moving_average([1, 2, 3, 4], 2) == [1.5, 2.5, 3.5]
+
+
+@pytest.mark.parametrize(
+    "xs, k, expected",
+    [
+        ([1, 2, 3, 4], 1, [1.0, 2.0, 3.0, 4.0]),
+        ([1, 2, 3, 4], 4, [2.5]),
+        ([1, 2, 3, 4], 5, []),
+        ([], 1, []),
+        ([10], 1, [10.0]),
+        ([-4, 2, 8], 2, [-1.0, 5.0]),
+    ],
+)
+def test_solo_ventanas_completas(xs, k, expected):
+    assert moving_average(xs, k) == expected
+
+
+@pytest.mark.parametrize("xs", [[1, 2, 3, 4], []])
+@pytest.mark.parametrize("k", [0, -1])
+def test_ventana_no_positiva(xs, k):
+    with pytest.raises(ValueError):
+        moving_average(xs, k)
+
+
+@pytest.mark.parametrize("k", [2.0, 0.0, -1.0, "2", None])
+def test_ventana_no_entera(k):
+    with pytest.raises(TypeError):
+        moving_average([1, 2, 3, 4], k)