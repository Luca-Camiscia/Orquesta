@@ -0,0 +1,35 @@
+import pytest
+
+from codigo import slugify
+
+
+@pytest.mark.parametrize(
+    ("title", "expected"),
+    [
+        ("¿Cómo está el niño?", "como-esta-el-nino"),
+        ("ÁÉÍÓÚ Ü Ñ", "aeiou-u-n"),
+        ("Cafe\u0301 y nin\u0303o", "cafe-y-nino"),
+        ("  Hola\t\n mundo  ", "hola-mundo"),
+        ("España / México: edición #2", "espana-mexico-edicion-2"),
+        ("--hola---mundo--", "hola-mundo"),
+        ("hola-mundo-123", "hola-mundo-123"),
+        ("¡Qué alegría!", "que-alegria"),
+        ("niño—niña", "nino-nina"),
+        ("hola«mundo»", "hola-mundo"),
+        ("café“recién”hecho", "cafe-recien-hecho"),
+        ("España…México", "espana-mexico"),
+        ("sol☀️luna", "sol-luna"),
+        ("", ""),
+        (" \t\n ", ""),
+        (" ¿?! / ", ""),
+        ("☀️", ""),
+    ],
+)
+def test_slugify_titulos_para_urls(title, expected):
+    assert slugify(title) == expected
+
+
+@pytest.mark.parametrize("title", [None, 123, 3.14, True, b"hola", [], {}])
+def test_slugify_rechaza_entradas_no_string(title):
+    with pytest.raises(TypeError):
+        slugify(title)