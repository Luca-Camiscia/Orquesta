diff --git a/codigo.py b/codigo.py
index 7398ad6..912183e 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,43 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Parsea un registro RFC 4180 con CRLF o LF final opcional.
+
+    Lanza ValueError si las comillas, los separadores o los controles son inválidos.
+    """
+    if line.endswith("\r\n"):
+        line = line[:-2]
+    elif line.endswith("\n"):
+        line = line[:-1]
+
+    fields = []
+    i = 0
+    while True:
+        field = []
+        if i < len(line) and line[i] == '"':
+            i += 1
+            while i < len(line):
+                if line[i] == '"':
+                    i += 1
+                    if i < len(line) and line[i] == '"':
+                        field.append('"')
+                    else:
+                        break
+                else:
+                    if (line[i] < " " and line[i] not in "\r\n") or line[i] == "\x7f":
+                        raise ValueError("Carácter de control inválido en campo CSV")
+                    field.append(line[i])
+                i += 1
+            else:
+                raise ValueError("Campo CSV con comillas sin cerrar")
+            if i < len(line) and line[i] != ",":
+                raise ValueError("Se esperaba una coma después de las comillas")
+        else:
+            while i < len(line) and line[i] != ",":
+                if line[i] in '"\r\n' or line[i] < " " or line[i] == "\x7f":
+                    raise ValueError("Comillas o control inválido en campo sin comillas")
+                field.append(line[i])
+                i += 1
+
+        fields.append("".join(field))
+        if i == len(line):
+            return fields
+        i += 1
