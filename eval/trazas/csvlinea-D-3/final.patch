@@ -0,0 +1,95 @@
+import pytest
+
+from codigo import parse_csv_line
+
+
+@pytest.mark.parametrize(
+    "line, expected",
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"a","b","c"', ["a", "b", "c"]),
+        ('"a""b",c', ['a"b', "c"]),
+        ('"a,""b""",c', ['a,"b"', "c"]),
+        ('""""', ['"']),
+        ('""', [""]),
+        ('"a"""', ['a"']),
+        ('""""""', ['""']),
+        ('"","",', ["", "", ""]),
+        (",a,,", ["", "a", "", ""]),
+        ("", [""]),
+        ("\r\n", [""]),
+        (' a ," b "', [" a ", " b "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\nb\rc",d', ["a\nb\rc", "d"]),
+        ('"\r\n"', ["\r\n"]),
+        ('"\n"', ["\n"]),
+        ("a,b\r\n", ["a", "b"]),
+        ('"a\r\nb","c"\r\n', ["a\r\nb", "c"]),
+        ("a,\r\n", ["a", ""]),
+        ('á,"ñ,漢字"', ["á", "ñ,漢字"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize("ending", ["\r\n", "\n"])
+@pytest.mark.parametrize(
+    "record, expected",
+    [
+        ("", [""]),
+        ("a,b", ["a", "b"]),
+        ('"a,b",c', ["a,b", "c"]),
+        ('"a,b"', ["a,b"]),
+        ("a,", ["a", ""]),
+        ('"\r\n"', ["\r\n"]),
+        ('"\n"', ["\n"]),
+        ('"a"""', ['a"']),
+    ],
+)
+def test_optional_record_ending(record, expected, ending):
+    assert parse_csv_line(record + ending) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"unclosed',
+        '"a""',
+        'a"b,c',
+        '"a"b,c',
+        ' "a",b',
+        "a\r\nb,c",
+        '"',
+        '"""',
+        '"a" ',
+        '"a"b',
+        '"a" ,b',
+        "a\nb,c",
+        "a\rb,c",
+        "a,b\r",
+        "a,b\n\n",
+        "a,b\r\n\r\n",
+        "a,b\r\r\n",
+        "a,b\nc,d\n",
+        '"a"\nb',
+        '"a"\r\nb',
+        '"unclosed\n',
+        '"unclosed\r\n',
+    ],
+)
+def test_invalid_csv_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
+
+
+@pytest.mark.parametrize(
+    "control", [chr(code) for code in range(32) if code not in (10, 13)] + ["\x7f"]
+)
+@pytest.mark.parametrize("quoted", [False, True])
+def test_invalid_ascii_control(control, quoted):
+    field = "a" + control + "b"
+    record = '"' + field + '"' if quoted else field
+    with pytest.raises(ValueError):
+        parse_csv_line(record)
