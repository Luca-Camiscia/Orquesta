+import pytest
+
 from codigo import parse_csv_line
 
 
 def test_simple():
     assert parse_csv_line("a,b,c") == ["a", "b", "c"]
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"a","b","c"', ["a", "b", "c"]),
+        ('"a""b,c",d', ['a"b,c', "d"]),
+        ('""""', ['"']),
+        ('"a"""', ['a"']),
+        ('""', [""]),
+        ('"a""b"', ['a"b']),
+        ('"a""b""c"', ['a"b"c']),
+        ("", [""]),
+        (",,", ["", "", ""]),
+        ('"",a,"",', ["", "a", "", ""]),
+        (' a ," b,c ", d ', [" a ", " b,c ", " d "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\nb",c', ["a\nb", "c"]),
+        ('"a\rb",c', ["a\rb", "c"]),
+        ("a,b\r\n", ["a", "b"]),
+        ('"a,b"\r\n', ["a,b"]),
+        (",\r\n", ["", ""]),
+        ('"á,ñ",漢字', ["á,ñ", "漢字"]),
+    ],
+)
+def test_rfc4180_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize("ending", ["\r\n", "\n", "\r"])
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ("a,b", ["a", "b"]),
+        ('"a,b"', ["a,b"]),
+        ("", [""]),
+        ('""', [""]),
+        ("a,", ["a", ""]),
+        ('"a\r\nb\nc\rd"', ["a\r\nb\nc\rd"]),
+        ('"a""b"', ['a"b']),
+    ],
+)
+def test_record_endings(line, expected, ending):
+    assert parse_csv_line(line + ending) == expected
+
+
+@pytest.mark.parametrize("ending", ["\r\n", "\n", "\r"])
+def test_file_read_with_universal_newlines(tmp_path, ending):
+    path = tmp_path / "records.txt"
+    path.write_bytes(('a,"b,c"' + ending).encode("utf-8"))
+    with path.open(encoding="utf-8") as records:
+        assert parse_csv_line(records.readline()) == ["a", "b,c"]
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"a,b',
+        '"a""',
+        'a"b,c',
+        '"a"b,c',
+        '"a" ,b',
+        "a\r\nb,c",
+        "a\nb,c",
+        '"',
+        '"a"""b"',
+        '"a"b',
+        ' "a",b',
+        "a\rb,c",
+        "a,b\n\n",
+        "a,b\r\r",
+        "a,b\r\n\r\n",
+        "a,b\n\r",
+        '"a,b\n',
+        '"a,b\r',
+        '"a,b\r\n',
+        '"a"\nb',
+    ],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
