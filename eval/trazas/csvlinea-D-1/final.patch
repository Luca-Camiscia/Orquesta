diff --git a/codigo.py b/codigo.py
index 7398ad6..37a9658 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,40 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Separa un registro RFC 4180, aceptando también terminadores LF o CR.
+
+    Lanza ValueError si el registro está mal formado.
+    """
+    if line.endswith("\r\n"):
+        line = line[:-2]
+    elif line.endswith(("\n", "\r")):
+        line = line[:-1]
+    fields = []
+    i = 0
+    while True:
+        field = []
+        if i < len(line) and line[i] == '"':
+            i += 1
+            while i < len(line):
+                char = line[i]
+                i += 1
+                if char == '"':
+                    if i < len(line) and line[i] == '"':
+                        field.append('"')
+                        i += 1
+                    else:
+                        break
+                else:
+                    field.append(char)
+            else:
+                raise ValueError("Campo CSV con comillas sin cerrar")
+            if i < len(line) and line[i] != ",":
+                raise ValueError("Se esperaba una coma después de las comillas")
+        else:
+            while i < len(line) and line[i] != ",":
+                if line[i] in '"\r\n':
+                    raise ValueError("Comillas o salto de línea en campo sin comillas")
+                field.append(line[i])
+                i += 1
+        fields.append("".join(field))
+        if i == len(line):
+            return fields
+        i += 1
diff --git a/test_visible.py b/test_visible.py
