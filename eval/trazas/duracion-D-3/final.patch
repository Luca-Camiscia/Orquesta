+import re
+
+
 def parse_duration(text: str) -> int:
-    """Convierte duraciones como "1h30m" o "45s" a segundos."""
-    total = 0
-    for unidad, factor in (("h", 3600), ("m", 60), ("s", 1)):
-        if unidad in text:
-            numero, text = text.split(unidad)
-            total += int(numero) * factor
-    return total
+    """Convierte enteros no negativos con unidades h, m, s en orden a segundos.
+
+    Las unidades son opcionales, pero debe aparecer al menos una.
+    Lanza ValueError si la entrada no tiene un formato válido.
+    """
+    match = (
+        re.fullmatch(r"(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", text)
+        if isinstance(text, str) and text
+        else None
+    )
+    if match is None:
+        raise ValueError("Duración inválida: se esperan enteros con unidades h, m, s en orden")
+    horas, minutos, segundos = (int(value or 0) for value in match.groups())
+    return horas * 3600 + minutos * 60 + segundos
