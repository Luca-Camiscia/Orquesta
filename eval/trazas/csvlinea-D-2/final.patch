diff --git a/codigo.py b/codigo.py
index 7398ad6..c263fa0 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,3 +1,41 @@
 def parse_csv_line(line: str) -> list[str]:
-    """Separa una línea CSV en campos."""
-    return line.split(",")
+    """Separa un registro RFC 4180; lanza ValueError si está mal formado.
+
+    Admite un terminador opcional CRLF, LF o CR por compatibilidad de lectura.
+    """
+    if line.endswith("\r\n"):
+        line = line[:-2]
+    elif line.endswith(("\n", "\r")):
+        line = line[:-1]
+
+    fields = []
+    i = 0
+    while True:
+        field = []
+        if i < len(line) and line[i] == '"':
+            i += 1
+            while i < len(line):
+                if line[i] == '"':
+                    if i + 1 < len(line) and line[i + 1] == '"':
+                        field.append('"')
+                        i += 2
+                        continue
+                    i += 1
+                    break
+                field.append(line[i])
+                i += 1
+            else:
+                raise ValueError("Campo CSV con comillas sin cerrar")
+            if i < len(line) and line[i] != ",":
+                raise ValueError("Contenido después del cierre de comillas")
+        else:
+            while i < len(line) and line[i] != ",":
+                if line[i] in '"\r\n':
+                    raise ValueError("Comillas o salto de línea en campo sin comillas")
+                field.append(line[i])
+                i += 1
+
+        fields.append("".join(field))
+        if i == len(line):
+            return fields
+        i += 1
diff --git a/test_visible.py b/test_visible.py
