@@ -1,5 +1,81 @@
+import pytest
+
 from codigo import parse_csv_line
 
 
 def test_simple():
     assert parse_csv_line("a,b,c") == ["a", "b", "c"]
+
+
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ('a,"b,c",d', ["a", "b,c", "d"]),
+        ('"a,b","c,d"', ["a,b", "c,d"]),
+        ('"a","b","c"', ["a", "b", "c"]),
+        ('"a""b,c",d', ['a"b,c', "d"]),
+        ('"a"""', ['a"']),
+        ('"a""b""c"', ['a"b"c']),
+        ('a,"",', ["a", "", ""]),
+        ('""""', ['"']),
+        ('""', [""]),
+        ("", [""]),
+        (",a,,", ["", "a", "", ""]),
+        ('"",a,""', ["", "a", ""]),
+        (' a ," b,c ", d ', [" a ", " b,c ", " d "]),
+        ('"a\r\nb",c', ["a\r\nb", "c"]),
+        ('"a\nb\rc",d', ["a\nb\rc", "d"]),
+        ("a,b\r\n", ["a", "b"]),
+        ('"a,b"\r\n', ["a,b"]),
+        ('"café,niño",sí', ["café,niño", "sí"]),
+    ],
+)
+def test_csv_fields(line, expected):
+    assert parse_csv_line(line) == expected
+
+
+@pytest.mark.parametrize("terminator", ["", "\r\n", "\n", "\r"])
+@pytest.mark.parametrize(
+    ("line", "expected"),
+    [
+        ("", [""]),
+        ("a,b", ["a", "b"]),
+        ('"a,b"', ["a,b"]),
+        ('"a"""', ['a"']),
+        ('a,"",', ["a", "", ""]),
+        ('"a\r\nb\n\r"', ["a\r\nb\n\r"]),
+    ],
+)
+def test_optional_record_terminator(line, expected, terminator):
+    assert parse_csv_line(line + terminator) == expected
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        '"a,b',
+        'a"b,c',
+        '"a"b,c',
+        '"a" ,c',
+        "a\r\nb,c",
+        "a\nb,c",
+        "a\rb,c",
+        '"',
+        '"a""',
+        '"a"b',
+        ' "a"',
+        '"a" ',
+        '"a"\nb',
+        '"a"\rb',
+        '"a"\r\nb',
+        '"a\n',
+        '"a\r\n',
+        "a\n\n",
+        "a\r\r",
+        "a\r\n\r\n",
+        "a\n\r",
+    ],
+)
+def test_rejects_malformed_record(line):
+    with pytest.raises(ValueError):
+        parse_csv_line(line)
