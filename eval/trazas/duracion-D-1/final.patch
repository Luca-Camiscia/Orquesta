@@ -0,0 +1,76 @@
+import pytest
+
+from codigo import parse_duration
+
+
+@pytest.mark.parametrize(
+    "text, expected",
+    [
+        ("1h", 3600),
+        ("30m", 1800),
+        ("45s", 45),
+        ("1h30m", 5400),
+        ("1h45s", 3645),
+        ("30m45s", 1845),
+        ("1h30m45s", 5445),
+        ("0h0m0s", 0),
+        ("0h", 0),
+        ("0m", 0),
+        ("0s", 0),
+        ("0h0m45s", 45),
+        ("90m", 5400),
+        ("120s", 120),
+        ("123h456m789s", 470949),
+        ("01h02m03s", 3723),
+    ],
+)
+def test_accepts_ordered_duration_units(text, expected):
+    assert parse_duration(text) == expected
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        "",
+        "basura",
+        "123",
+        "h",
+        "1h30",
+        "1hbasura",
+        "45sxyz",
+        "1h2h",
+        "1m2m",
+        "1s2s",
+        "1m2h",
+        "1s2m",
+        "1s2h",
+        "1h2s3m",
+        "1m2h3s",
+        "1h2m3h",
+        "1hm",
+        "-1h",
+        "+1m",
+        "1.5h",
+        "1H",
+        " 1h",
+        "1h ",
+        "1h 30m",
+        "1h,30m",
+        "\t1h",
+        "\n1s",
+        "1s\n",
+        "1s\x00",
+        "١h",
+        "１h",
+        None,
+        45,
+        1.5,
+        True,
+        b"45s",
+        [],
+        {},
+    ],
+)
+def test_rejects_invalid_duration(text):
+    with pytest.raises(ValueError, match="[Dd]uraci[oó]n"):
+        parse_duration(text)