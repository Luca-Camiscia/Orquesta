@@ -1,8 +1,21 @@
+import re
+
+
 def parse_duration(text: str) -> int:
-    """Convierte duraciones como "1h30m" o "45s" a segundos."""
-    total = 0
-    for unidad, factor in (("h", 3600), ("m", 60), ("s", 1)):
-        if unidad in text:
-            numero, text = text.split(unidad)
-            total += int(numero) * factor
-    return total
+    """Convierte enteros no negativos con unidades h, m, s en orden a segundos.
+
+    Cada componente es opcional, pero se requiere al menos uno con su unidad.
+    Un formato inválido o una entrada no string genera ValueError.
+    """
+    match = (
+        re.fullmatch(r"(?:([0-9]+)h)?(?:([0-9]+)m)?(?:([0-9]+)s)?", text)
+        if isinstance(text, str)
+        else None
+    )
+    if match is None or not text:
+        raise ValueError(
+            "Duración inválida: usá enteros con unidades h, m, s en ese orden "
+            "(por ejemplo, 1h30m45s)."
+        )
+    horas, minutos, segundos = (int(numero or 0) for numero in match.groups())
+    return horas * 3600 + minutos * 60 + segundos
