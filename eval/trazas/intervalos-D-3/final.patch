diff --git a/codigo.py b/codigo.py
index 19b1861..0f12b0c 100644
--- a/codigo.py
+++ b/codigo.py
@@ -1,8 +1,8 @@
 def merge_intervals(intervals):
     """Une intervalos cerrados [a, b] que se solapan."""
     result = []
-    for a, b in intervals:
-        if result and a < result[-1][1]:
+    for a, b in sorted(intervals, key=lambda interval: interval[0]):
+        if result and a <= result[-1][1]:
             result[-1][1] = max(result[-1][1], b)
         else:
             result.append([a, b])
diff --git a/test_visible.py b/test_visible.py
index d20886e..7c92894 100644
--- a/test_visible.py
+++ b/test_visible.py
@@ -3,3 +3,48 @@ from codigo import merge_intervals
 
 def test_basico():
     assert merge_intervals([[1, 3], [2, 6], [8, 10]]) == [[1, 6], [8, 10]]
+
+
+def test_extremo_compartido():
+    assert merge_intervals([[1, 2], [2, 2], [2, 3]]) == [[1, 3]]
+
+
+def test_desordenados_con_union_en_cadena():
+    assert merge_intervals([[8, 10], [2, 6], [1, 3], [6, 8]]) == [[1, 10]]
+
+
+def test_desordenados_con_intervalos_separados():
+    assert merge_intervals([[8, 10], [1, 3], [2, 6]]) == [[1, 6], [8, 10]]
+
+
+def test_lista_vacia():
+    assert merge_intervals([]) == []
+
+
+def test_un_solo_intervalo():
+    assert merge_intervals([[1, 5]]) == [[1, 5]]
+
+
+def test_intervalos_anidados():
+    assert merge_intervals([[2, 3], [1, 10], [1, 5], [4, 8]]) == [[1, 10]]
+
+
+def test_intervalos_duplicados():
+    assert merge_intervals([[1, 2], [1, 2]]) == [[1, 2]]
+
+
+def test_valores_negativos():
+    assert merge_intervals([[-5, -1], [-2, 2]]) == [[-5, 2]]
+
+
+def test_intervalos_degenerados_disjuntos():
+    assert merge_intervals([[1, 1], [3, 3]]) == [[1, 1], [3, 3]]
+
+
+def test_no_modifica_la_entrada():
+    intervals = [[8, 10], [1, 3], [2, 6]]
+    result = merge_intervals(intervals)
+    assert result == [[1, 6], [8, 10]]
+    assert intervals == [[8, 10], [1, 3], [2, 6]]
+    result[0][1] = 100
+    assert intervals == [[8, 10], [1, 3], [2, 6]]