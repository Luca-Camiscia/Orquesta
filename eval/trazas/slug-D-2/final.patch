@@ -0,0 +1,39 @@
+import pytest
+
+from codigo import slugify
+
+
+@pytest.mark.parametrize(
+    ("title", "expected"),
+    [
+        ("Canción del año: pingüino", "cancion-del-ano-pinguino"),
+        ("ÁÉÍÓÚ Ñ Ü", "aeiou-n-u"),
+        ("Cancio\u0301n del an\u0303o", "cancion-del-ano"),
+        ("¿Qué tal? ¡Hola, mundo!", "que-tal-hola-mundo"),
+        ("  Hola\t\n mundo  ", "hola-mundo"),
+        ("Guía/python_2026 -- edición #2", "guia-python-2026-edicion-2"),
+        ("niño—niña", "nino-nina"),
+        ("niño–niña", "nino-nina"),
+        ("hola«mundo»", "hola-mundo"),
+        ("hola“mundo”", "hola-mundo"),
+        ("hola…mundo", "hola-mundo"),
+        ("niño¿niña", "nino-nina"),
+        ("niño\u0085niña", "nino-nina"),
+        ("niño\u00a0niña", "nino-nina"),
+        ("niño😊niña", "nino-nina"),
+        ("«—Hola——mundo—»", "hola-mundo"),
+        ("hola-mundo", "hola-mundo"),
+        ("", ""),
+        (" ¿¡?! --- ", ""),
+        ("«—😊»", ""),
+        ("\u0301\u0303", ""),
+    ],
+)
+def test_slugify_titulos_espanoles_para_urls(title, expected):
+    assert slugify(title) == expected
+
+
+@pytest.mark.parametrize("value", [None, 123, b"hola", [], {}])
+def test_slugify_rechaza_entradas_que_no_son_texto(value):
+    with pytest.raises(TypeError):
+        slugify(value)